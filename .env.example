# Enterprise IDP local environment template.
# Copy to `.env` and replace placeholder values with your local settings.

# Selects the datastore backend the FastAPI backend and worker use:
# "mongo" (default, MongoDB Atlas-compatible, used against the local mongo:7
# container) or "cosmos" (kept as a config-selectable fallback/rollback path
# against the Cosmos DB Emulator). Both are fully implemented and tested.
DB_BACKEND=mongo

# MongoDB connection string used by the FastAPI backend when DB_BACKEND=mongo.
# This targets the local mongo:7 Docker Compose service on its default port.
MONGO_CONNECTION_STRING=mongodb://localhost:27017/?directConnection=true

# Cosmos DB Emulator connection string used by the FastAPI backend when
# DB_BACKEND=cosmos. This uses the emulator's documented default key so the
# local stack works immediately after copy.
COSMOS_CONNECTION_STRING=AccountEndpoint=https://localhost:8081/;AccountKey=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMIZnqyMsEcaGQy67XIw/Jw==;

# Azurite Blob Storage connection string used for document blobs.
# This uses Azurite's documented default development key.
AZURITE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;

# Azurite Queue Storage connection string used for async job messages.
# This uses Azurite's documented default development key.
AZURITE_QUEUE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;QueueEndpoint=http://127.0.0.1:10001/devstoreaccount1;

# SMTP relay host used for review-needed notification emails.
# Local dev default targets the Mailpit catcher (unauthenticated, no TLS).
SMTP_HOST=127.0.0.1

# SMTP relay port. Local dev default targets Mailpit.
SMTP_PORT=1025

# Mail relay auth mode: "none" (default, unauthenticated -- Mailpit/legacy
# internal open relay) or "basic" (SMTP AUTH with SMTP_USERNAME/SMTP_PASSWORD
# below). Use "basic" for authenticated relays (e.g. M365 SMTP AUTH,
# SendGrid, Mailgun) and for a private authenticated relay reachable only
# over a VNet/private endpoint -- the app-level config is identical, only
# network reachability differs.
MAIL_AUTH_MODE=none

# Mail relay TLS mode: "none" (default), "starttls" (upgrade a plaintext
# connection, typical for port 587 authenticated relays), or "smtps"
# (implicit TLS, typical for port 465).
MAIL_TLS_MODE=none

# SMTP AUTH username, only used when MAIL_AUTH_MODE=basic.
# SMTP_USERNAME=svc-notifications@example.com

# SMTP AUTH password/secret, only used when MAIL_AUTH_MODE=basic. In
# production this should come from Key Vault, never committed to `.env`.
# SMTP_PASSWORD=change-me

# From address used on outbound notification emails. Authenticated relays
# typically require this to be a verified/allowed sender.
MAIL_FROM_ADDRESS=enterprise-idp@localhost

# Allowed browser origin for FastAPI CORS.
WEB_ORIGIN=http://localhost:3000

# Browser-visible base URL for direct frontend -> backend API calls.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional Azure Monitor / Application Insights connection string. When set,
# OpenTelemetry exports traces here instead of the console exporter.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Optional OTLP collector endpoint (e.g. the docker-compose otel-collector
# service, or any local OpenTelemetry Collector/Grafana Alloy). When set,
# traces, metrics, and logs are all exported here via OTLP/HTTP instead of
# the console/Azure Monitor fallbacks. Takes precedence over
# APPLICATIONINSIGHTS_CONNECTION_STRING. `docker compose up` sets this
# automatically for the containerized api/worker services; set it manually
# (e.g. http://127.0.0.1:4318) when running the api/worker as host processes
# against the compose-provided collector.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Local-only escape hatch for Docker Compose app-profile runs that reach the
# Cosmos emulator by its service DNS hostname instead of localhost. Leave false
# for the normal host-process workflow and all non-emulator environments.
COSMOS_TLS_INSECURE=false

# Azure AI Content Understanding endpoint (real Azure resource required).
# Replace this before starting the API unless you already have apps/api/.env.
CU_ENDPOINT=

# Optional Azure AI Content Understanding API key. Leave blank when your Azure
# AI resource has local auth disabled and you authenticate via `az login`
# instead. The Compose app profile mounts the host's ~/.azure directory so the
# API/worker containers can reuse that Azure CLI login.
CU_API_KEY=

# Azure AI Content Understanding model deployment name.
CU_MODEL_DEPLOYMENT=
