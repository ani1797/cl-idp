    },
    {
      "id": "f3bt",
      "type": "text",
      "x": 590,
      "y": 1240,
      "width": 420,
      "height": 550,
      "angle": 0,
      "strokeColor": "#79001a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "f3",
      "index": null,
      "roundness": null,
      "seed": 26,
      "version": 2,
      "versionNonce": 1003632622,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789084853271,
      "link": null,
      "locked": false,
      "text": "4  UNDERSTAND\nStream clean Blob bytes to Content Understanding\nRouting analyzer classifies to the approved form model\nExtract recursive typed fields, source coordinates and confidence\nRecord analyzer and policy version on the job\n\n5  QUALITY GATE\nEvaluate confidence threshold, completeness and business rules\nUnclassified documents are valid exception outcomes\nHigh-confidence results continue automatically\nLow-confidence or policy exceptions enter review\n\n6  HUMAN REVIEW\nLine-of-business skill queue with SLA and priority routing\nSide-by-side document evidence and extracted values\nApprove, correct or escalate; preserve original and reviewer attribution",
      "originalText": "4  UNDERSTAND\nStream clean Blob bytes to Content Understanding\nRouting analyzer classifies to the approved form model\nExtract recursive typed fields, source coordinates and confidence\nRecord analyzer and policy version on the job\n\n5  QUALITY GATE\nEvaluate confidence threshold, completeness and business rules\nUnclassified documents are valid exception outcomes\nHigh-confidence results continue automatically\nLow-confidence or policy exceptions enter review\n\n6  HUMAN REVIEW\nLine-of-business skill queue with SLA and priority routing\nSide-by-side document evidence and extracted values\nApprove, correct or escalate; preserve original and reviewer attribution",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.28,
      "autoResize": true
    },
