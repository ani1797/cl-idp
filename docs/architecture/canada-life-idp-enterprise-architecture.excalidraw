    {
      "id": "f4at",
      "type": "text",
      "x": 1765,
      "y": 1235,
      "width": 310,
      "height": 510,
      "angle": 0,
      "strokeColor": "#79001a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
