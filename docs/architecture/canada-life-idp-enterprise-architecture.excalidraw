      "versionNonce": 130,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789084000000,
      "link": null,
      "locked": false,
      "text": "PLATFORM SCALE PRINCIPLE\nThe API tier stays responsive because document work is asynchronous. Service Bus absorbs enterprise bursts; independently scalable AKS workers consume at the rate allowed by AI quotas and downstream capacity. Per-business-unit quotas, priorities, cost budgets and dead-letter handling prevent one workload from starving the enterprise platform.",
      "originalText": "PLATFORM SCALE PRINCIPLE\nThe API tier stays responsive because document work is asynchronous. Service Bus absorbs enterprise bursts; independently scalable AKS workers consume at the rate allowed by AI quotas and downstream capacity. Per-business-unit quotas, priorities, cost budgets and dead-letter handling prevent one workload from starving the enterprise platform.",
      "fontSize": 19,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.35,
      "autoResize": true
    },
