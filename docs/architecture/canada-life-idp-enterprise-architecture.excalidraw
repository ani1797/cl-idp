      "roundness": null,
      "seed": 24,
      "version": 2,
      "versionNonce": 11686200,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789084853271,
      "link": null,
      "locked": false,
      "text": "1  INTAKE\nWeb / API / event / SFTP / mailbox / Blob\nAuthenticate caller; resolve business unit and process\nCreate idempotency key and correlation ID\n\n2  QUARANTINE\nValidate file; store write-once; malware scan; DLP/classify\nReject or release a clean immutable source object\n\n3  ORCHESTRATE\nPersist job; enqueue Service Bus message\nApply tenant quota, priority and SLA class\nAutoscale workers from queue depth and oldest-message age\nRetry transient failures; poison messages move to DLQ",
      "originalText": "1  INTAKE\nWeb / API / event / SFTP / mailbox / Blob\nAuthenticate caller; resolve business unit and process\nCreate idempotency key and correlation ID\n\n2  QUARANTINE\nValidate file; store write-once; malware scan; DLP/classify\nReject or release a clean immutable source object\n\n3  ORCHESTRATE\nPersist job; enqueue Service Bus message\nApply tenant quota, priority and SLA class\nAutoscale workers from queue depth and oldest-message age\nRetry transient failures; poison messages move to DLQ",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.28,
      "autoResize": true
    },
