    {
      "id": "f3at",
      "type": "text",
      "x": 70,
      "y": 1240,
      "width": 420,
      "height": 550,
      "angle": 0,
      "strokeColor": "#004f4f",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
