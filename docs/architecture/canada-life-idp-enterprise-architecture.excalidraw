    },
    {
      "id": "f4bt",
      "type": "text",
      "x": 2165,
      "y": 1235,
      "width": 310,
      "height": 510,
      "angle": 0,
      "strokeColor": "#004f4f",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "f4",
      "index": null,
      "roundness": null,
      "seed": 36,
      "version": 2,
      "versionNonce": 271002041,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789084853271,
      "link": null,
      "locked": false,
      "text": "GOVERNED MODEL LIFECYCLE\n\nBUILD\nCurated samples, labeling and analyzer configuration\n\nEVALUATE\nAccuracy, confidence, bias, cost, latency and security tests\n\nAPPROVE\nModel approver + process owner; immutable evidence\n\nPROMOTE\nDev \u2192 Test \u2192 Prod with versioned analyzer IDs\n\nOPERATE\nDrift monitoring, canary, rollback and retirement\n\nEvery job records model and policy versions for reproducibility.",
      "originalText": "GOVERNED MODEL LIFECYCLE\n\nBUILD\nCurated samples, labeling and analyzer configuration\n\nEVALUATE\nAccuracy, confidence, bias, cost, latency and security tests\n\nAPPROVE\nModel approver + process owner; immutable evidence\n\nPROMOTE\nDev \u2192 Test \u2192 Prod with versioned analyzer IDs\n\nOPERATE\nDrift monitoring, canary, rollback and retirement\n\nEvery job records model and policy versions for reproducibility.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
