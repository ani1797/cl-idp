      "versionNonce": 3034,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789085700000,
      "link": null,
      "locked": false,
      "text": "REGIONAL FAILOVER \u2014 PLANNING TARGET RTO 4 HOURS / RPO 15 MINUTES\nDeclare and authorize failover \u2192 freeze nonessential writes \u2192 verify replication point \u2192 promote Atlas/Storage and regional integration endpoints\nScale DR AKS and APIM \u2192 update private DNS and internal routes \u2192 recreate incomplete Service Bus work from durable job state \u2192 validate downstream delivery\nQuarterly technical failover, annual business continuity exercise, and post-test evidence are mandatory. Failback is a separate controlled change.",
      "originalText": "REGIONAL FAILOVER \u2014 PLANNING TARGET RTO 4 HOURS / RPO 15 MINUTES\nDeclare and authorize failover \u2192 freeze nonessential writes \u2192 verify replication point \u2192 promote Atlas/Storage and regional integration endpoints\nScale DR AKS and APIM \u2192 update private DNS and internal routes \u2192 recreate incomplete Service Bus work from durable job state \u2192 validate downstream delivery\nQuarterly technical failover, annual business continuity exercise, and post-test evidence are mandatory. Failback is a separate controlled change.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.35,
      "autoResize": true
    },
