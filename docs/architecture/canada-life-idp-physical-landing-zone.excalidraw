    {
      "id": "lz-decisions-t",
      "type": "text",
      "x": 1765,
      "y": 1865,
      "width": 1460,
      "height": 150,
      "angle": 0,
      "strokeColor": "#79001a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
