      "boundElements": null,
      "updated": 1789085894342,
      "link": null,
      "locked": false,
      "text": "NON-PRODUCTION\ncl-idp-nonprod\n\nVNet 10.122.0.0/16\nPeered to primary hub with stricter egress controls\n\nEnvironments\nDevelopment\nIntegration test\nPerformance test\nPre-production validation\n\nSeparate resources\nAKS, Storage, Service Bus, Atlas, Key Vault and Content Understanding analyzer estate\n\nControls\nNo production data\nSynthetic/de-identified samples\nlower quotas and budgets\nsame policy baseline\npromotion through CI/CD only\nno network path to production data plane",
      "originalText": "NON-PRODUCTION\ncl-idp-nonprod\n\nVNet 10.122.0.0/16\nPeered to primary hub with stricter egress controls\n\nEnvironments\nDevelopment\nIntegration test\nPerformance test\nPre-production validation\n\nSeparate resources\nAKS, Storage, Service Bus, Atlas, Key Vault and Content Understanding analyzer estate\n\nControls\nNo production data\nSynthetic/de-identified samples\nlower quotas and budgets\nsame policy baseline\npromotion through CI/CD only\nno network path to production data plane",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.23,
      "autoResize": true
