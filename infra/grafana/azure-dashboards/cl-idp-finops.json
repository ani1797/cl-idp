{
  "uid": "cl-idp-finops-azure",
  "title": "CL-IDP \u2014 FinOps (Azure Monitor)",
  "description": "Azure Managed Grafana equivalent of the local docker-compose cl-idp-finops dashboard, backed by the shared Log Analytics/Application Insights workspace. Cost figures come from the worker.job_cost_usd OTel counter (Content Understanding per-page rate estimate, app/pricing.py), exported to customMetrics.",
  "tags": [
    "cl-idp",
    "finops",
    "azure-monitor"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "process_id",
        "type": "textbox",
        "label": "process_id (regex)",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Cost Overview",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total estimated cost (all time)",
      "description": "",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "grafana-azure-monitor-datasource"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "customMetrics | where name == \"worker.job_cost_usd\" | summarize sum(valueSum)\n",
            "resources": [
              "__LOG_ANALYTICS_WORKSPACE_RESOURCE_ID__"
            ],
            "resultFormat": "table"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cost in selected range",
