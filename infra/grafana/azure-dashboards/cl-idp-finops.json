    {
      "id": 6,
      "type": "stat",
      "title": "Avg cost per document",
      "description": "",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "grafana-azure-monitor-datasource"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "customMetrics\n| where name in (\"worker.job_cost_usd\", \"worker.jobs_processed\")\n| where tostring(customDimensions.process_id) matches regex $process_id\n| summarize cost = sumif(valueSum, name == \"worker.job_cost_usd\"), docs = sumif(valueSum, name == \"worker.jobs_processed\" and tostring(customDimensions.outcome) == \"success\")\n| project avg_cost = cost / docs\n",
            "resources": [
              "__LOG_ANALYTICS_WORKSPACE_RESOURCE_ID__"
            ],
            "resultFormat": "table"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Forecast: next 24h spend (linear, trailing 24h rate)",
      "description": "Trailing-24h spend used as the linear forecast baseline for the next 24h, same assumption as the local Grafana panel's `predict_linear`.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "datasource": {
        "type": "grafana-azure-monitor-datasource"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "customMetrics\n| where name == \"worker.job_cost_usd\"\n| where timestamp > ago(24h)\n| summarize sum(valueSum)\n",
            "resources": [
              "__LOG_ANALYTICS_WORKSPACE_RESOURCE_ID__"
            ],
            "resultFormat": "table"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Cumulative estimated cost over time",
      "description": "",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "grafana-azure-monitor-datasource"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "customMetrics\n| where name == \"worker.job_cost_usd\"\n| where tostring(customDimensions.process_id) matches regex $process_id\n| summarize cost = sum(valueSum) by bin(timestamp, 1h)\n| order by timestamp asc\n| extend cumulative_cost = row_cumsum(cost)\n| project timestamp, cumulative_cost\n",
            "resources": [
              "__LOG_ANALYTICS_WORKSPACE_RESOURCE_ID__"
            ],
            "resultFormat": "time_series"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
