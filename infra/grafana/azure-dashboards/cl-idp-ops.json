    {
      "id": 9,
      "type": "gauge",
      "title": "Job success ratio",
      "description": "",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 4,
        "y": 9
      },
      "datasource": {
        "type": "grafana-azure-monitor-datasource"
