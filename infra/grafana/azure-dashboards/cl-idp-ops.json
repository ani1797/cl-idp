    {
      "id": 23,
      "type": "timeseries",
      "title": "Worker \u2014 message-handling duration p95 by outcome (worker.dequeue span)",
      "description": "Real per-message percentiles from the 'worker.dequeue' root span, which wraps the entire dequeue->persist handling of one queue message.",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "datasource": {
        "type": "grafana-azure-monitor-datasource"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "AppRequests\n| where cloud_RoleName has \"worker\" and Name == \"worker.dequeue\"\n| summarize p95_s = percentile(DurationMs, 95) / 1000 by bin(TimeGenerated, 1h), outcome = tostring(Properties.outcome)\n| order by TimeGenerated asc\n",
