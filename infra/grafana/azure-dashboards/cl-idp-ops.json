{
  "uid": "cl-idp-ops-azure",
  "title": "CL-IDP \u2014 Operations (Azure Monitor)",
  "description": "Azure Managed Grafana equivalent of the local docker-compose cl-idp-ops dashboard, backed by the shared Log Analytics/Application Insights workspace instead of Prometheus/Loki/Tempo. Pipeline-stage and end-to-end durations use real span percentiles (AppRequests/AppDependencies), not histogram averages \u2014 see docs/spec/TECHNOLOGY.md 'Dashboards'.",
  "tags": [
    "cl-idp",
    "operations",
    "azure-monitor"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "process_id",
        "type": "textbox",
        "label": "process_id (regex)",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      },
      {
        "name": "detected_form",
        "type": "textbox",
        "label": "detected_form (regex)",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      },
      {
        "name": "correlation_id",
        "type": "textbox",
        "label": "correlation_id (regex)",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      }
    ]
  },
