        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "customMetrics\n| where name == \"worker.jobs_processed\"\n| where tostring(customDimensions.process_id) matches regex $process_id\n| summarize total = sum(valueSum), success = sumif(valueSum, tostring(customDimensions.outcome) == \"success\")\n| project ratio = success * 1.0 / total\n",
            "resources": [
              "__LOG_ANALYTICS_WORKSPACE_RESOURCE_ID__"
            ],
            "resultFormat": "table"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
