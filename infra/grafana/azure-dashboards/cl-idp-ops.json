    {
      "id": 13,
      "type": "timeseries",
      "title": "End-to-end pipeline duration \u2014 p50 / p95, by process (job.pipeline span)",
      "description": "Real percentiles computed directly from the 'job.pipeline' span (submittedAt -> completedAt, recorded explicitly with the job's true elapsed wall-clock interval via observability.record_duration_span) \u2014 not an OTel histogram average. Azure Monitor's custom-metrics exporter drops histogram bucket boundaries, so this span is the accurate replacement for the local dashboard's `histogram_quantile(worker_job_pipeline_duration_seconds_bucket)` panel.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "grafana-azure-monitor-datasource"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "AppDependencies\n| where Name == \"job.pipeline\"\n| where tostring(Properties.process_id) matches regex $process_id and tostring(Properties.detected_form) matches regex $detected_form\n| summarize p50_s = percentile(DurationMs, 50) / 1000, p95_s = percentile(DurationMs, 95) / 1000 by bin(TimeGenerated, 1h), process_id = tostring(Properties.process_id)\n| order by TimeGenerated asc\n",
            "resources": [
              "__LOG_ANALYTICS_WORKSPACE_RESOURCE_ID__"
            ],
            "resultFormat": "time_series"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
