{
  "id": null,
  "uid": "cl-idp-finops",
  "title": "CL-IDP \u2014 FinOps",
  "description": "Cost visibility for the Enterprise IDP pipeline: spend by business process and form type, forecasts, unit economics, and onboarding/notification cost drivers. Select a single business process in the variable above to drill into its per-form cost breakdown.",
  "tags": [
    "cl-idp",
    "enterprise-idp",
    "finops"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "links": [
    {
      "title": "CL-IDP \u2014 Operations",
      "type": "link",
      "url": "/d/cl-idp-ops",
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "process_id",
        "type": "query",
        "label": "Business process (select one to drill down)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(worker_job_cost_usd_total, process_id)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "detected_form",
        "type": "query",
        "label": "Form type",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(worker_job_cost_usd_total, detected_form)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
