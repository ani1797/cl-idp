        "textMode": "auto",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "predict_linear(worker_job_cost_usd_total{process_id=~\"$process_id\",detected_form=~\"$detected_form\"}[6h], 86400) - worker_job_cost_usd_total{process_id=~\"$process_id\",detected_form=~\"$detected_form\"}"
