  "templating": {
    "list": [
      {
        "name": "process_id",
        "type": "query",
        "label": "Business process",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(worker_jobs_processed_total, process_id)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "detected_form",
        "type": "query",
        "label": "Form type",
