          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(worker_job_cost_usd_total, detected_form)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "correlation_id",
        "type": "textbox",
        "label": "Correlation ID",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      }
    ]
